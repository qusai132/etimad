# Database
DATABASE_URL=postgresql+asyncpg://etimad:etimad_pass@localhost:5432/etimad_db
DATABASE_URL_SYNC=postgresql://etimad:etimad_pass@localhost:5432/etimad_db

# Security
SECRET_KEY=change-me-to-a-random-secret-key-32-chars-min

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=Etimad Tenders Monitor

# AI Matching (OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Scraper
SCRAPER_BASE_URL=https://tenders.etimad.sa/Tender/AllTendersForVisitor
SCRAPER_INTERVAL_MINUTES=60
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_MS=30000

# Company Profile
COMPANY_NAME=شركة التقنية المتقدمة
COMPANY_ACTIVITIES=تقنية المعلومات,برمجيات,استشارات تقنية,أمن معلومات,شبكات
RELEVANCE_THRESHOLD=0.6

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Environment
ENVIRONMENT=development
